<configuration>
<property name="DATA" value="${hive.dataDir:-${LOCALAPPDATA}/HIVE13}"/>
<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><charset>UTF-8</charset><pattern>%date{HH:mm:ss} %-5level %logger{24} - %msg%n</pattern></encoder></appender>
<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender"><file>${DATA}/logs/hive.log</file><rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"><fileNamePattern>${DATA}/logs/hive.%d{yyyy-MM-dd}.log</fileNamePattern><maxHistory>5</maxHistory></rollingPolicy><encoder><charset>UTF-8</charset><pattern>%date %-5level %logger{24} - %msg%n</pattern></encoder></appender>
<root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
